# Key-Holder Gateway environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# ── Gateway ──────────────────────────────────────────────────────────────────
GATEWAY_PORT=3001
GATEWAY_HOST=0.0.0.0

# SQLite DB path (relative to packages/gateway)
DATABASE_PATH=./data/gateway.db

# AES-256-GCM secret store encryption key (REQUIRED — gateway refuses to start without it).
# NEVER commit real keys.
ENCRYPTION_KEY=FAKE_DEV_ENCRYPTION_KEY_32BYTES_REQUIRED_FOR_SECRET_STORAGE

# DEV token signing secret (REQUIRED when TideCloak container is not running).
DEV_TOKEN_SECRET=FAKE_DEV_TOKEN_SECRET_DO_NOT_USE_IN_PRODUCTION

# Quorum configuration (default 2-of-3)
QUORUM_REQUIRED=2
QUORUM_TOTAL=3

# Action request TTL in seconds (default 1 hour)
ACTION_TTL_SECONDS=3600

# ── TideCloak ─────────────────────────────────────────────────────────────────
# TODO(P1): Fill in after running TideCloak dev image and creating realm/client.
# See docs/VERIFY_TIDECLOAK.md for the bootstrap checklist.
TIDECLOAK_URL=http://localhost:8080
TIDECLOAK_REALM=key-holder
TIDECLOAK_CLIENT_ID=gateway-client
TIDECLOAK_CLIENT_SECRET=CHANGEME

# Adapter JSON (exported from TideCloak, contains embedded JWK).
# Set ONE of these. File path is relative to packages/gateway.
# TIDECLOAK_ADAPTER_FILE=./data/tidecloak.json
# TIDECLOAK_ADAPTER_JSON={"realm":"...","auth-server-url":"...","jwk":{...}}
# TIDECLOAK_ADAPTER_B64=base64encodedAdapterJson

# ── MCP Server ───────────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio
# Set to 'sse' and configure port for HTTP transport:
# MCP_PORT=3002

# ── Guardian UI ──────────────────────────────────────────────────────────────
VITE_GATEWAY_URL=http://localhost:3001
VITE_TIDECLOAK_URL=http://localhost:8080
VITE_TIDECLOAK_REALM=key-holder
VITE_TIDECLOAK_CLIENT_ID=guardian-ui

# ── Mock Environment ─────────────────────────────────────────────────────────
FAKE_PRODUCTION_PORT=4001
FAKE_EXTERNAL_PORT=4002

# ── Secrets (ALL FAKE - labelled clearly) ────────────────────────────────────
# These are placeholder values for the demo only.
# See mock-env/fixtures/fake-secrets.txt
FAKE_API_KEY=FAKE-API-KEY-DO-NOT-USE-abc123xyz
FAKE_DB_PASSWORD=FAKE-DB-PASS-DO-NOT-USE-hunter2
